<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:IndDictionary"
             x:Class="IndDictionary.WordPage"
             xmlns:res="clr-namespace:IndDictionary.addition"
             x:Name="contPage"
             Title="Dictionary">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="showSecond" Clicked="OnShowTranslation" Text="W"/>
        <ToolbarItem Clicked="OnAddPressed"
                     IconImageSource="{res:ImageResourceExt DictMobile.Resources.Images.add1.png}"/>
        
    </ContentPage.ToolbarItems>
    <Grid x:Name="MainStack"
      BackgroundColor="{AppThemeBinding Dark={StaticResource BackgroundDark},
                                        Light={StaticResource BackgroundLight}}">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>

                <!-- Portrait -->
                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="601"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="MainStack"
                            Property="RowDefinitions">
                            <Setter.Value>
                                <RowDefinitionCollection>
                                    <RowDefinition Height="6*"/>
                                    <RowDefinition Height="88*"/>
                                    <RowDefinition Height="6*"/>
                                </RowDefinitionCollection>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>

                <!-- Landscape -->
                <VisualState x:Name="Landscape">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="601"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="MainStack"
                            Property="RowDefinitions">
                            <Setter.Value>
                                <RowDefinitionCollection>
                                    <RowDefinition Height="6*"/>
                                    <RowDefinition Height="80*"/>
                                    <RowDefinition Height="12*"/>
                                </RowDefinitionCollection>
                            </Setter.Value>
                        </Setter>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    </Grid>



</ContentPage>