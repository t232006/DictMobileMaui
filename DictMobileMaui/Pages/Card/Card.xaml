<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:IndDictionary" 
             xmlns:res="clr-namespace:IndDictionary.Converters"
             x:Class="IndDictionary.Card">

    <ContentPage.Resources>
        <ResourceDictionary>
            
            
        </ResourceDictionary>
        <res:BoolToBorderStyle x:Key="boolToBorderStyle"/>
    </ContentPage.Resources>
    <StackLayout x:Name="MainStack" x:FieldModifier="protected">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NormalGroup">
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="DarkSalmon"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="White"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </StackLayout>
</ContentPage>
