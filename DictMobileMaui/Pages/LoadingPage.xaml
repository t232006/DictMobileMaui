<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DictMobile.Pages.LoadingPage"
             Title="LoadingPage">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
        <ActivityIndicator 
            IsRunning="True" Color="DodgerBlue" HeightRequest="50" WidthRequest="50" />
        <Label
            Text="Синхронизация..." FontSize="18" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>