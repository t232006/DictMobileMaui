<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="3"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 40,15"/>
        <!--Setter Property="WidthRequest" Value="400"/>
<Setter Property="HeightRequest" Value="800"/-->
    </Style>
    <Style x:Key="CardTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CardStyle1" TargetType="Border" BasedOn="{StaticResource  CardStyle}">
        <Setter Property="Stroke" Value="#4CAF50"/>
        <Setter Property="BackgroundColor" Value="#E8F5E9"/>
        <!--Setter Property="WidthRequest" Value="400"/>
    <Setter Property="HeightRequest" Value="800"/-->
    </Style>
    <Style x:Key="CardTextStyle1" TargetType="Label" BasedOn="{StaticResource  CardTextStyle}">
        <Setter Property="TextColor" Value="#2E7D32"/>
    </Style>
    <Style x:Key="CardStyle2" TargetType="Border" BasedOn="{StaticResource  CardStyle}">
        <Setter Property="Stroke" Value="#FF9800"/>
        <Setter Property="BackgroundColor" Value="#FFF8E1"/>
        <!--Setter Property="WidthRequest" Value="400"/>
<Setter Property="HeightRequest" Value="800"/-->
    </Style>
    <Style x:Key="CardTextStyle2" TargetType="Label" BasedOn="{StaticResource  CardTextStyle}">
        <Setter Property="TextColor" Value="#F57C00"/>
    </Style>
</ResourceDictionary>